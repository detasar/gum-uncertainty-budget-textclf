{
  "title": "A GUM-style uncertainty budget for split-conformal text classification (AG News)",
  "date_run": "2026-10-17",
  "data": {
    "dataset": "fancyzhx/ag_news (Hugging Face), parquet files data/train-00000-of-00001.parquet and data/test-00000-of-00001.parquet",
    "dataset_revision_sha": "eb185aade064a813bc0b7f42de02595523103ca4",
    "classes": [
      "World",
      "Sports",
      "Business",
      "Sci/Tech"
    ],
    "subsets": "prep_data.py, numpy default_rng(0): 2000 balanced train items; 2000 balanced test items split into a 1000 calibration pool and a 1000 test pool. Shared evaluation subset for every model = first 250 of the calibration pool and first 250 of the test pool (data/zs_set.json). Scaling test uses calibration pool items 0..499 (Clef only).",
    "shift": "Synthetic covariate shift: each word dropped with p=level/2, remaining words >3 chars get an adjacent swap or deletion with p=level; seed 1000+item index. Levels 0, 0.15, 0.3, 0.45 (supervised); 0.3 for the shared comparison."
  },
  "models": {
